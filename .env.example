# Required for OAuth SSO. Use the client id for this app (e.g. WebClientId3 from cognito-dev in .jmus/outputs.json).
COGNITO_CLIENT_APP_ID='your-cognito-client-app-id'
COGNITO_TEST_USER='your-test-user@example.com'
COGNITO_TEST_PASSWORD='your-test-password'

# Optional: set to prod when deploying. Defaults to local/dev.
# JMUS_ENV=dev
