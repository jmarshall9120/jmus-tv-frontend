# AWS Cognito Authentication Patterns

## OAuth SSO Flow (Latest Pattern - bloggenai)

The most recent pattern uses OAuth code flow with SSO instead of direct Cognito Auth.

### Auth Composable Pattern

```typescript
// composables/useAuth.ts
export const useAuth = () => {
  const runtimeConfig = useRuntimeConfig()
  const cognitoClientAppId = runtimeConfig.public.cognitoClientAppId as string
  
  /**
   * Get SSO URL based on environment
   */
  const getSsoUrl = (): string => {
    const env = runtimeConfig.public.env || 'local'
    return env === 'prod' ? 'https://sso.example.com' : 'https://dev.sso.example.com'
  }

  /**
   * Get callback URL for OAuth redirect
   */
  const getCallbackUrl = (): string => {
    if (import.meta.server) return 'http://localhost:3000/callback'
    return `${window.location.origin}/callback`
  }

  /**
   * Redirect to SSO for OAuth authorization
   */
  const signIn = (email?: string) => {
    if (import.meta.server) return

    // Generate state parameter for CSRF protection
    const state = crypto.randomUUID()
    localStorage.setItem('oauth_state', state)
    
    // Store intended redirect
    const currentPath = window.location.pathname + window.location.search
    const shouldSaveRedirect = !currentPath.startsWith('/callback') && !currentPath.startsWith('/login')
    
    if (shouldSaveRedirect) {
      localStorage.setItem('auth_redirect', currentPath)
    } else {
      localStorage.setItem('auth_redirect', '/')
    }

    const ssoUrl = getSsoUrl()
    const callbackUrl = getCallbackUrl()
    
    // Build OAuth authorization URL
    const params = new URLSearchParams()
    params.set('client_id', cognitoClientAppId)
    params.set('redirect_uri', callbackUrl)
    params.set('state', state)
    
    if (email) {
      params.set('email', email)
    }

    const loginUrl = `${ssoUrl}?${params.toString()}`
    window.location.href = loginUrl
  }

  /**
   * Exchange authorization code for tokens via GraphQL
   */
  const exchangeCodeForTokens = async (code: string): Promise<{
    accessToken: string
    idToken: string
    refreshToken: string
    expiresAt: string
  }> => {
    const config = useState<{ grantsEndpoint: string; grantsApiKey: string }>('amplify:pub').value
    const graphqlEndpoint = config.grantsEndpoint
    const apiKey = config.grantsApiKey
    
    const query = `
      query ExchangeAuthCode($code: String!, $clientId: String!) {
        exchangeAuthCode(code: $code, clientId: $clientId) {
          accessToken
          idToken
          refreshToken
          expiresAt
          clientId
        }
      }
    `
    
    const response = await fetch(graphqlEndpoint, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'x-api-key': apiKey,
      },
      body: JSON.stringify({
        query,
        variables: { code, clientId: cognitoClientAppId },
      }),
    })

    if (!response.ok) {
      throw new Error(`Token exchange failed: ${await response.text()}`)
    }

    const result = await response.json()
    
    if (result.errors) {
      throw new Error(`GraphQL error: ${result.errors[0].message}`)
    }
    
    return result.data.exchangeAuthCode
  }

  /**
   * Store tokens in localStorage and start refresh loop
   */
  const saveTokens = (tokens: {
    accessToken: string
    idToken: string
    refreshToken: string
    expiresAt: string
  }) => {
    const expiryTime = new Date(tokens.expiresAt).getTime()
    
    localStorage.setItem('access_token', tokens.accessToken)
    localStorage.setItem('id_token', tokens.idToken)
    localStorage.setItem('refresh_token', tokens.refreshToken)
    localStorage.setItem('token_expiry', expiryTime.toString())
    
    startTokenRefreshLoop()
  }

  /**
   * Get stored tokens from localStorage
   */
  const getTokens = () => {
    return {
      accessToken: localStorage.getItem('access_token'),
      idToken: localStorage.getItem('id_token'),
      refreshToken: localStorage.getItem('refresh_token'),
      tokenExpiry: localStorage.getItem('token_expiry'),
    }
  }

  /**
   * Check if user is authenticated
   */
  const isAuthenticated = async (): Promise<boolean> => {
    if (import.meta.server) return false

    const { accessToken, idToken, tokenExpiry } = getTokens()
    
    if (!accessToken || !idToken) return false

    // Check if token is expired
    const expiry = parseInt(tokenExpiry || '0')
    const now = Date.now()
    
    if (expiry <= now) return false

    return true
  }

  /**
   * Get access token for API calls
   */
  const getAccessToken = (): string | null => {
    if (import.meta.server) return null
    return localStorage.getItem('access_token')
  }

  /**
   * Get ID token for user info
   */
  const getIdToken = (): string | null => {
    if (import.meta.server) return null
    return localStorage.getItem('id_token')
  }

  /**
   * Get user email from ID token
   */
  const getUserEmail = (): string | null => {
    const idToken = getIdToken()
    if (!idToken) return null

    try {
      const parts = idToken.split('.')
      if (parts.length < 2 || !parts[1]) return null
      const payload = JSON.parse(atob(parts[1]))
      return payload.email || null
    } catch {
      return null
    }
  }

  /**
   * Get Cognito user ID from ID token
   */
  const getCognitoId = (): string | null => {
    const idToken = getIdToken()
    if (!idToken) return null

    try {
      const parts = idToken.split('.')
      if (parts.length < 2 || !parts[1]) return null
      const payload = JSON.parse(atob(parts[1]))
      return payload.sub || null
    } catch {
      return null
    }
  }

  /**
   * Sign out user
   */
  const signOut = () => {
    if (import.meta.server) return

    // Clear tokens
    localStorage.removeItem('access_token')
    localStorage.removeItem('id_token')
    localStorage.removeItem('refresh_token')
    localStorage.removeItem('token_expiry')
    localStorage.removeItem('oauth_state')
    localStorage.removeItem('auth_redirect')

    // Redirect to SSO logout
    const ssoUrl = getSsoUrl()
    const redirectUrl = window.location.origin
    window.location.href = `${ssoUrl}/logout?redirect=${encodeURIComponent(redirectUrl)}`
  }

  return {
    signIn,
    signOut,
    isAuthenticated,
    exchangeCodeForTokens,
    saveTokens,
    getAccessToken,
    getIdToken,
    getUserEmail,
    getCognitoId,
  }
}
```

### Auth Middleware Pattern

```typescript
// middleware/auth.global.ts
export default defineNuxtRouteMiddleware(async (to, from) => {
  // Skip on server-side
  if (import.meta.server) return

  // Initialize token refresh loop if we have tokens
  const { startTokenRefreshLoop } = useAuth()
  if (!(window as any).__authRefreshLoopStarted) {
    const hasTokens = localStorage.getItem('access_token') && localStorage.getItem('refresh_token')
    if (hasTokens) {
      startTokenRefreshLoop()
      ;(window as any).__authRefreshLoopStarted = true
    }
  }

  // Define public routes
  const publicRoutes = ['/login', '/callback']
  const isPublicRoute = publicRoutes.some(route => to.path === route || to.path.startsWith(route))

  if (isPublicRoute) return

  // Check authentication
  const { isAuthenticated } = useAuth()
  const authenticated = await isAuthenticated()
  
  if (!authenticated) {
    // Store intended destination
    if (import.meta.client && !publicRoutes.includes(to.path)) {
      sessionStorage.setItem('auth_redirect', to.fullPath)
    }
    
    return navigateTo('/login')
  }
})
```

## Legacy Pattern (IvonneWelchDashboard)

For reference, the older pattern uses Amplify Auth directly:

```typescript
// stores/auth.ts - Legacy pattern
import { getCurrentUser, fetchAuthSession } from "@aws-amplify/auth"

export const useAuthStore = defineStore('auth', () => {
  const userId = ref('')
  const tokens = ref<AuthSession['tokens']>()

  const isAuthenticated = computed(() => Boolean(userId.value))

  async function setUser() {
    const authUser = await getCurrentUser()
    userId.value = authUser.userId
    const authSession = await fetchAuthSession()
    tokens.value = authSession.tokens
  }

  return { userId, tokens, isAuthenticated, setUser }
})
```

## Important Notes

- **Use OAuth SSO flow** (bloggenai pattern) for new projects
- **Store tokens in localStorage** - access_token, id_token, refresh_token, token_expiry
- **Use ID token** for user info (email, Cognito ID, grants)
- **Handle token refresh** automatically with refresh loop
- **Use middleware** for route protection
- **Check existing auth implementations** before creating new auth flows
- **Parse JWT tokens** manually to extract user info (email, sub, custom:grants)
